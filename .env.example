# KUBECONFIG: 조사 대상 클러스터의 kubeconfig 경로.
#   - 샌드박스(기본): .local/kind-kubeconfig.yaml
#   - 실 dev 클러스터: ~/.kube/config (아래 2계층 모델 참고)
KUBECONFIG=.local/kind-kubeconfig.yaml

# --- 실 dev 클러스터 read-only 조사 (2계층 모델) ---
# 실 클러스터(aws/azure dev)를 read-only로 조사하려면 명시적 opt-in이 필요하다.
# 4중 방어선이 admin 자격증명이어도 GET만 내보내지만, 실 클러스터 접속은 의도적 선택이어야 한다.
# prod/production 마커가 있는 컨텍스트는 opt-in이어도 거부된다 (fail-fast).
#   AGENT_ALLOW_REAL_CLUSTER=1
#   KUBECONFIG=~/.kube/config
#   KUBE_CONTEXT=aws-seoul-clouddev
# AGENT_ALLOW_REAL_CLUSTER=0
# KUBE_CONTEXT=

# --- 소스 열람 (선택) ---
# 설정 시 SSH로 개발 서버의 앱 소스를 read-only 조회하는 도구(src_*)가 활성화된다.
# 명령 화이트리스트(ls/sed/grep/find/git/svn read)만 실행되며 비대화형 키 인증만 쓴다.
# SOURCE_SSH_HOST=heejoon@172.29.70.161

# --- 샌드박스 보안 테스트 (선택, 인가된 pentest용) ---
# 두 도구의 격리 등급은 서로 다르다. 혼동하지 말 것:
#  * sandbox_bash  : 격리 컨테이너(자격증명 무마운트·네트워크 화이트리스트·non-root·
#                    read-only rootfs)에서만 실행 → 호스트/실 인프라 도달 불가.
#  * sandbox_pentest_strix : strix 가 자체 도커 컨테이너를 띄우는 오케스트레이터라
#                    **호스트에서 직접 실행된다**. 방어는 ①호스트 env 무상속(화이트리스트
#                    조립) ②전용 HOME/cwd(.local/pentest) ③대상 허용목록+하드 denylist
#                    ④실 클러스터 모드에서 전면 비활성 — "실 인프라 도달 불가"가 아니라
#                    "자격증명 무상속 + 허용목록 밖 거부"가 보증 범위다.
# SANDBOX_BASH_ENABLED=1   # sandbox_bash 도구 (격리 컨테이너 bash)
# STRIX_ENABLED=1          # sandbox_pentest_strix 도구 (strix CLI 필요)
#
# STRIX_ALLOWED_TARGETS: strix 대상 허용목록을 랩 환경에 맞게 **치환**한다(콤마 구분,
# CIDR / 호스트명 / *.도메인). 미설정 시 기본값만 허용된다:
#   루프백(127.0.0.0/8, ::1) · 로컬 kind(172.18.0.0/16) · *.vmlab.test · .local/pentest/
# 사설 대역 전체(10/8·192.168/16)와 클러스터 내부 DNS(.svc/.local)는 기본 거부다 —
# 운영자 호스트가 VPN/사내망에 있으면 실 dev 클러스터로 라우팅되기 때문.
# 치환 시 루프백·kind 가 필요하면 함께 나열해야 한다. 하드 denylist(링크로컬·CGNAT·
# kubeconfig API 서버·실 nexus-shell base 및 그 해석 IP)는 이 변수로도 풀 수 없다.
# 또한 1차 형태 필터가 항상 먼저 돌기 때문에 이 변수로 **공개 도메인·공개 IP 로는 넓힐 수
# 없다** — 등록 가능한 이름은 .test/.local/.svc/-sandbox 형태의 사설 실증 도메인뿐이다.
# STRIX_ALLOWED_TARGETS=127.0.0.0/8,172.18.0.0/16,*.vmlab.test

# --- nexus-lake Trino 데이터 분석 (선택) ---
# TRINO_ENDPOINT=http://localhost:8080   # port-forward 등으로 도달 가능한 Trino 주소
# TRINO_USER=analyst
# TRINO_TOKEN=                            # JWT 인증 시

# --- nexus-shell 로그인 HTTP 조사 (선택) ---
# 자격증명은 scripts/set-credentials.py 로 입력하면 안전하게 .env에 저장된다:
#   .venv/bin/python scripts/set-credentials.py vm --base https://nexus.vmlab.test
# 또는 직접 작성 (이 .env는 gitignore됨):
# SHELL_ENVS=vm,aws,azure
# SHELL_VM_BASE=https://nexus.vmlab.test
# SHELL_VM_USER=
# SHELL_VM_PASSWORD=
# SHELL_AWS_BASE=https://nexus.clouddev.dev.genians.kr
# SHELL_AWS_USER=
# SHELL_AWS_PASSWORD=
# SHELL_AZURE_BASE=https://nexus.gsp.genians.com
# SHELL_AZURE_USER=
# SHELL_AZURE_PASSWORD=

# MODEL_PROVIDER: LLM 연결 방식.
#   codex-oauth : ChatGPT Plus/Pro 구독의 Codex OAuth 세션 재사용 (API 키 불필요, 기본값)
#                 1회 로그인: `langchain-codex-oauth auth login`
#   fake        : 테스트용 결정론적 모의 모델 (네트워크 미사용)
# 주의: 이 프로젝트는 OpenAI API 키를 어디에서도 요구하지 않는다.
MODEL_PROVIDER=codex-oauth

# Codex 모델 이름 (codex-oauth 프로바이더에서만 사용).
# 계정/플랜별 지원 모델이 다르다 — codex CLI(~/.codex/config.toml)의 model 값과 맞추면 안전.
CODEX_MODEL=gpt-5.6-sol

# Codex 추론 단계: low | medium | high 만 허용.
# "minimal"/"none"(fast 모드)과 "xhigh"/"ultra"는 정책상 코드가 거부한다.
CODEX_REASONING_EFFORT=medium

# 위키 큐레이터 (LLM 주기 보정: 사실체크·폐기·중복정리)
# CURATOR_ENABLED=1            # 백그라운드 주기 실행 활성화
# CURATOR_INTERVAL_S=21600     # 사이클 간격(초, 기본 6시간)

# 샌드박스 실증 이미지 (code-reviewer가 코드 재현 시 필요한 런타임)
# SANDBOX_IMAGE=python:3.12-slim   # 기본 alpine:latest (sh만)

# Jira read-only 연동 (코드 리뷰 시 이슈 참고) — 아래 3줄만 설정하면 활성화
# JIRA_BASE_URL=https://ims.cloud.genians.com
# JIRA_TOKEN=<Personal Access Token>   # Jira Server/DC: 프로필 > Personal Access Tokens 에서 발급
# JIRA_USER=                            # 비우면 PAT(Bearer). Cloud/basic이면 이메일 입력
# JIRA_VERIFY_TLS=1                     # 사설 CA면 0
# JIRA_COOKIE=                          # SSO 전용 인스턴스 폴백: 브라우저 세션 쿠키 붙여넣기
#                                       # (예: "JSESSIONID=...; ...") — PAT를 못 쓸 때만

# Slack 아침 트리아지 개인 DM 알림 (docs/slack-setup.md 참고)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...   # 가장 간단(권장)
# SLACK_BOT_TOKEN=xoxb-...            # 대안: 봇 토큰
# SLACK_DM_CHANNEL=U0XXXXXXX          # 봇 방식일 때 본인 멤버 ID
