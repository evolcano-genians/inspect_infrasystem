# KUBECONFIG: 조사 대상 클러스터의 kubeconfig 경로.
#   - 샌드박스(기본): .local/kind-kubeconfig.yaml
#   - 실 dev 클러스터: ~/.kube/config (아래 2계층 모델 참고)
KUBECONFIG=.local/kind-kubeconfig.yaml

# --- 실 dev 클러스터 read-only 조사 (2계층 모델) ---
# 실 클러스터(aws/azure dev)를 read-only로 조사하려면 명시적 opt-in이 필요하다.
# 4중 방어선이 admin 자격증명이어도 GET만 내보내지만, 실 클러스터 접속은 의도적 선택이어야 한다.
# prod/production 마커가 있는 컨텍스트는 opt-in이어도 거부된다 (fail-fast).
#   AGENT_ALLOW_REAL_CLUSTER=1
#   KUBECONFIG=~/.kube/config
#   KUBE_CONTEXT=aws-seoul-clouddev
# AGENT_ALLOW_REAL_CLUSTER=0
# KUBE_CONTEXT=

# MODEL_PROVIDER: LLM 연결 방식.
#   codex-oauth : ChatGPT Plus/Pro 구독의 Codex OAuth 세션 재사용 (API 키 불필요, 기본값)
#                 1회 로그인: `langchain-codex-oauth auth login`
#   fake        : 테스트용 결정론적 모의 모델 (네트워크 미사용)
# 주의: 이 프로젝트는 OpenAI API 키를 어디에서도 요구하지 않는다.
MODEL_PROVIDER=codex-oauth

# Codex 모델 이름 (codex-oauth 프로바이더에서만 사용).
# 계정/플랜별 지원 모델이 다르다 — codex CLI(~/.codex/config.toml)의 model 값과 맞추면 안전.
CODEX_MODEL=gpt-5.6-sol

# Codex 추론 단계: low | medium | high 만 허용.
# "minimal"/"none"(fast 모드)과 "xhigh"/"ultra"는 정책상 코드가 거부한다.
CODEX_REASONING_EFFORT=medium
